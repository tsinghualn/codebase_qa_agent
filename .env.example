# Copy to `.env` (gitignored). Never commit real values.

# LLM — M2+ agent (not used for ingest / embeddings)
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=openai

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Chroma on disk + local embeddings (single model for ingest and search)
CHROMA_PATH=data/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_MODE=hybrid

# Optional observability (LangSmith)
# LANGCHAIN_API_KEY=
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_PROJECT=codebase-qa-agent